# ============================================
# Secrets (never commit)
# ============================================
.env
.env.*
!.env.example
.envrc
*.pem
*.key
secrets/

# ============================================
# Python
# ============================================
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ============================================
# Foundry (contracts/lib holds git submodules: do not ignore it)
# ============================================
contracts/out/
contracts/cache/
contracts/broadcast/

# ============================================
# Data, databases and results
# ============================================
# Dataset is downloaded, database is generated; only the instructions are tracked
data/*
!data/README.md
*.db
*.sqlite
*.sqlite3
# Generated results stay local; copy the ones the report uses into results/final/
results/*
!results/final/

# ============================================
# Node (only if JS tooling is added later)
# ============================================
node_modules/

# ============================================
# Logs and temporary files
# ============================================
*.log
logs/
tmp/
*.tmp
*.bak

# ============================================
# Editors and OS
# ============================================
.vscode/
.idea/
.vs/
*.swp
*~
.DS_Store
._*
Thumbs.db

# ============================================
# Local-only material
# ============================================
# Personal agent guidance, project specs and local backups
/.agent/
/spec/
/AGENTS.md
/CLAUDE.md
/backup/
/backups/

# Starter kit for a different project (its README says it stays local)
setup/
documentation/internal/
tmpclaude-*
START_HERE.md
docs/BUILD_GUIDE.md
.claude/settings.local.json

# Research papers and dataset copies: copyrighted or too large for git.
# The reading guide stays tracked.
docs/**/*.pdf
docs/**/*.csv
