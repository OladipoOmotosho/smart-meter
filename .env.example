# Copy this file to .env and fill in the values.
# The keys below come from the list Anvil prints when you start it (make chain).
# Anvil's accounts are throwaway test accounts. Never put a real wallet key here.

RPC_URL=http://127.0.0.1:8545

# Anvil account 0: deploys the contract and grants roles
ADMIN_PRIVATE_KEY=

# Anvil account 1: the trusted aggregator that commits fingerprints
AGGREGATOR_ADDRESS=
AGGREGATOR_PRIVATE_KEY=

# Anvil account 2: the attacker used in the unauthorized-submission test
ATTACKER_PRIVATE_KEY=

# Filled in after `make deploy` prints the contract address
CONTRACT_ADDRESS=

# Local paths (relative to the repo root)
DATASET_PATH=data/ampds2_whe.csv
DB_PATH=data/utility.db
RESULTS_PATH=results/results.csv
