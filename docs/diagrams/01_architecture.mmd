    classDef store fill:#FCEFC7,stroke:#B98200,color:#0F1E24
    classDef chain fill:#1F6F73,stroke:#0F1E24,color:#FFFFFF
    classDef audit fill:#EEF3F2,stroke:#3E5459,color:#0F1E24
    classDef ok fill:#2E8B57,stroke:#1E5C3A,color:#FFFFFF
    classDef bad fill:#C2452D,stroke:#7E2A1B,color:#FFFFFF
    classDef warn fill:#F2A900,stroke:#9A6B00,color:#0F1E24
    classDef attack fill:#FBE3DE,stroke:#C2452D,color:#7E2A1B
    classDef ext fill:#FFFFFF,stroke:#B98200,color:#0F1E24,stroke-dasharray: 5 3
    classDef tool fill:#FFFFFF,stroke:#6B8F94,color:#3E5459

    class RM,DCN,HES,MDMS ctx
    class DS,SIM src
    class SER,RKEY,HASH,W3A trusted
    class BATCH ext
    class DB,LOG,ST store
    class SC,AC,FN chain
    class RD,RC,CMP,CH audit
    class OK ok
    class BAD bad
    class MISS warn
    class A1,A2,A3,A4 attack
    class FG,GH tool
